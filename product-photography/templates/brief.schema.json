{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Single-frame product photography brief",
  "description": "A planning contract, not an execution API or proof of authorization. Inspect actual references and verify current runtime capabilities before any paid call.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task", "product_mode", "fidelity", "product", "references", "shot", "look", "scene", "camera", "lighting", "text", "output", "constraints", "assumptions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task": {"enum": ["prompt_only", "generate_image"], "description": "Requested deliverable. This field does not grant billing or account permissions."},
    "product_mode": {"enum": ["concept", "reference"]},
    "fidelity": {"enum": ["concept", "reference_guided", "protected_composite"]},
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "state", "observed", "user_supplied", "unknown", "identity_lock"],
      "properties": {
        "summary": {"$ref": "#/$defs/nonempty"},
        "state": {"$ref": "#/$defs/nonempty"},
        "observed": {"$ref": "#/$defs/stringList", "description": "Only visually inspected facts; never infer these from a filename or product name."},
        "user_supplied": {"$ref": "#/$defs/stringList", "description": "User statements or delegated fictional design facts, not independently observed evidence."},
        "unknown": {"$ref": "#/$defs/stringList"},
        "identity_lock": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}, "description": "Freeze the observed real-product identity or approved fictional design. Do not treat this wording as a fidelity guarantee."}
      }
    },
    "references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "source", "use"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "description": "Use unique IDs and resolve to actual attachment order before prompt compilation."},
          "role": {"enum": ["product", "style", "material", "label"]},
          "source": {"$ref": "#/$defs/nonempty", "description": "Internal source locator, not model prompt text. Verify authorization, accessibility, and supported transport separately. Treat example:// as illustrative regardless of case or leading whitespace."},
          "use": {"$ref": "#/$defs/nonempty", "description": "State exactly what this reference may influence; style cannot override SKU identity."}
        }
      }
    },
    "shot": {
      "type": "object", "additionalProperties": false, "required": ["type", "purpose", "required_visible", "required_printing"],
      "properties": {
        "type": {"enum": ["studio", "lifestyle", "macro", "flat_lay", "hero"]},
        "purpose": {"$ref": "#/$defs/nonempty"},
        "required_visible": {"$ref": "#/$defs/stringList", "minItems": 1, "description": "Agreed product region/components that must appear. Macro crops may intentionally exclude the full silhouette and off-frame marks."},
        "required_printing": {"$ref": "#/$defs/stringList", "description": "Describe marks that must appear/read clearly, without transcribing source text as new copy. Use an empty array when printing is deliberately excluded."}
      }
    },
    "look": {
      "type": "object", "additionalProperties": false, "required": ["preset", "palette", "notes"],
      "properties": {
        "preset": {"enum": ["neutral", "fresh_natural", "dark_luxury", "custom"]},
        "palette": {"$ref": "#/$defs/stringList", "description": "Bind each color to an object or surface. Do not recolor the real SKU."},
        "notes": {"$ref": "#/$defs/nonempty"}
      }
    },
    "scene": {
      "type": "object", "additionalProperties": false, "required": ["setting", "surface", "props"],
      "properties": {
        "setting": {"$ref": "#/$defs/nonempty"},
        "surface": {"$ref": "#/$defs/nonempty"},
        "props": {"$ref": "#/$defs/stringList"}
      }
    },
    "camera": {
      "type": "object", "additionalProperties": false, "required": ["angle", "framing", "focus"],
      "properties": {
        "angle": {"$ref": "#/$defs/nonempty"},
        "framing": {"$ref": "#/$defs/nonempty"},
        "focus": {"$ref": "#/$defs/nonempty"}
      }
    },
    "lighting": {
      "type": "object", "additionalProperties": false, "required": ["key", "fill_and_separation", "shadows"],
      "properties": {
        "key": {"$ref": "#/$defs/nonempty"},
        "fill_and_separation": {"$ref": "#/$defs/nonempty"},
        "shadows": {"$ref": "#/$defs/nonempty"}
      }
    },
    "text": {
      "type": "object", "additionalProperties": false, "required": ["mode", "copy"],
      "properties": {
        "mode": {"enum": ["no_added_text", "preserve_print", "concept_label"]},
        "copy": {"$ref": "#/$defs/stringList", "description": "Only exact authorized fictional label strings. Do not transcribe real-product printing here or add ad copy."}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "concept_label"}}, "required": ["mode"]},
          "then": {"properties": {"copy": {"minItems": 1}}},
          "else": {"properties": {"copy": {"maxItems": 0}}}
        }
      ]
    },
    "output": {
      "type": "object", "additionalProperties": false, "required": ["count", "size", "format", "quality", "background"],
      "properties": {
        "count": {"const": 1},
        "size": {"type": "string", "pattern": "^(auto|[1-9][0-9]*x[1-9][0-9]*)$", "description": "Requested dimensions only. Model-specific supported values and actual returned dimensions require runtime verification."},
        "format": {"enum": ["png", "jpeg", "webp"]},
        "quality": {"enum": ["auto", "low", "medium", "high"]},
        "background": {"enum": ["auto", "opaque", "transparent"], "description": "Requested requirement, not a support guarantee. Verify current model capability and actual output alpha separately."}
      },
      "allOf": [
        {
          "if": {"properties": {"format": {"const": "jpeg"}}, "required": ["format"]},
          "then": {"properties": {"background": {"enum": ["auto", "opaque"]}}}
        }
      ]
    },
    "constraints": {
      "type": "object", "additionalProperties": false, "required": ["must_include", "must_avoid"],
      "properties": {
        "must_include": {"$ref": "#/$defs/stringList"},
        "must_avoid": {"$ref": "#/$defs/stringList"}
      }
    },
    "assumptions": {"$ref": "#/$defs/stringList"}
  },
  "allOf": [
    {
      "if": {"properties": {"product_mode": {"const": "reference"}}, "required": ["product_mode"]},
      "then": {
        "properties": {
          "fidelity": {"enum": ["reference_guided", "protected_composite"]},
          "references": {"minItems": 1, "contains": {"properties": {"role": {"const": "product"}}, "required": ["role"]}},
          "text": {"properties": {"mode": {"const": "preserve_print"}}}
        }
      },
      "else": {
        "properties": {
          "fidelity": {"const": "concept"},
          "text": {"properties": {"mode": {"enum": ["no_added_text", "concept_label"]}}}
        }
      }
    },
    {
      "if": {"properties": {"task": {"const": "generate_image"}}, "required": ["task"]},
      "then": {
        "properties": {
          "references": {"items": {"properties": {"source": {"not": {"pattern": "^\\s*[eE][xX][aA][mM][pP][lL][eE]://"}}}}}
        },
        "allOf": [
          {
            "if": {"properties": {"product_mode": {"const": "reference"}}, "required": ["product_mode"]},
            "then": {"properties": {"product": {"properties": {"observed": {"minItems": 1}}}}}
          }
        ]
      }
    }
  ],
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "stringList": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}}
  }
}
